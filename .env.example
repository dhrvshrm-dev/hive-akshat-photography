# Copy this file to ".env.local" and fill in real values when you wire up email + database.
# The site runs fine locally without these — the contact form will just log to the terminal.

# Where contact-form enquiries should be emailed (Akshat's inbox)
CONTACT_TO_EMAIL=query@hiveakshat.com

# Resend (https://resend.com) — for sending the enquiry email. Optional for local dev.
RESEND_API_KEY=

# Database connection string (e.g. Supabase / Neon Postgres) — for saving enquiries. Optional for local dev.
DATABASE_URL=
