# Copy this file to ".env.local" (local) or add the same keys in Vercel →
# Project → Settings → Environment Variables (live site).
# Locally, with nothing set, the contact form just logs enquiries to the terminal.

# Where contact-form enquiries are emailed.
CONTACT_TO_EMAIL=shrmadhruv11@gmail.com

# ---- Provider 1: Resend (https://resend.com) — recommended -----------------
# Before the domain is verified in Resend, leave CONTACT_FROM_EMAIL empty: mail is
# sent from onboarding@resend.dev, which only delivers to the Resend account's
# own email — so create the Resend account with CONTACT_TO_EMAIL above.
# After verifying the domain: CONTACT_FROM_EMAIL="Hive Akshat <hello@yourdomain.com>"
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# ---- Provider 2: SMTP — automatic backup if Resend fails --------------------
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
